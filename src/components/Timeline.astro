---
import type { Entry } from '../data/profile'
import type { Lang } from '../i18n'

interface Props {
  lang: Lang
  title: string
  entries: Entry[]
}

const { lang, title, entries } = Astro.props
---

<section class="timeline">
  <h3>{title}</h3>
  <ol>
    {
      entries.map((e) => (
        <li>
          <p class="period">{e.period[lang]}</p>
          <div>
            <h4>{e.title[lang]}</h4>
            <p class="org">{e.org[lang]}</p>
            {e.points && (
              <ul>
                {e.points.map((p) => (
                  <li set:html={p[lang]} />
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline + .timeline {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  ol {
    list-style: none;
    padding: 0;
  }

  ol > li {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 0.25rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .period {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  h4 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .org {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 0.25rem;
  }

  ul {
    margin-top: 0.75rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.375rem;
    max-width: var(--measure);
  }

  ul li::marker {
    color: var(--accent);
  }

  @media (max-width: 44rem) {
    ol > li {
      grid-template-columns: 1fr;
    }
  }
</style>
